{
    "Quality Request Item": [
        {
            "fieldname": "custom_myqima_booking_id",
            "fieldtype": "Data",
            "insert_after": "qc_inspector_name",
            "label": "MyQima Booking ID"
        },
        {
            "fieldname": "custom_myqima_order_number",
            "fieldtype": "Data",
            "insert_after": "custom_myqima_booking_id",
            "label": "MyQima Order Number"
        },
        {
            "fieldname": "custom_create_inspection",
            "fieldtype": "Button",
            "label": "Create Inspection",
            "insert_after": "custom_myqima_order_number"
        },
        {
            "fieldname": "custom_myqima_inspection_created",
            "fieldtype": "Check",
            "label": "MYqima Inspection Created",
            "insert_after": "custom_create_inspection"
        },
        {
            "fieldname": "custom_myqima_product_id",
            "fieldtype": "Data",
            "insert_after": "custom_myqima_inspection_created",
            "label": "MyQima Product ID"
        }
    ]
}
